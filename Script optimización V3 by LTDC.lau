--========================================================--
-- FPS
--========================================================--

function enableFPS()

	createStatsGUI()

	states["FPS"] = true

	fpsBox.Visible = true

	frameCount = 0

	lastFPSTime = tick()

	fpsBox.Text =
		"FPS  ..."

	if fpsConnection then
		return
	end

	fpsConnection =
		RunService.RenderStepped:Connect(function()

			if not states["FPS"] then
				return
			end

			frameCount += 1

			local now =
				tick()

			if now - lastFPSTime >= 0.5 then

				currentFPS =
					math.floor(
						frameCount /
						(now - lastFPSTime)
					)

				fpsBox.Text =
					"FPS  "..tostring(
						currentFPS
					)

				frameCount = 0

				lastFPSTime = now

			end

		end)

end


function disableFPS()

	states["FPS"] = false

	if fpsConnection then

		fpsConnection:Disconnect()

		fpsConnection = nil

	end

	if fpsBox then

		fpsBox.Text = "FPS"

		fpsBox.Visible = false

	end

end

--========================================================--
-- PING
--========================================================--

function enablePing()

	createStatsGUI()

	states["Ping Monitor"] = true

	pingBox.Visible = true

	pingBox.Text =
		"PING  ..."

	if pingThread then
		return
	end

	pingThread =
		task.spawn(function()

			while states["Ping Monitor"] do

				local ping = 0

				pcall(function()

					local serverStats =
						Stats.Network.ServerStatsItem

					local dataPing =
						serverStats:FindFirstChild(
							"Data Ping"
						)

					if dataPing then

						ping =
							math.floor(
								dataPing:GetValue()
							)

					end

				end)

				pingBox.Text =
					"PING  "..tostring(
						ping
					).." ms"

				task.wait(1)

			end

			pingThread = nil

		end)

end


function disablePing()

	states["Ping Monitor"] = false

	if pingBox then

		pingBox.Text = "PING"

		pingBox.Visible = false

	end

end

--========================================================--
-- PANTALLA
--========================================================--

local function enableScreen()

	for _,obj in ipairs(
		player.PlayerGui:GetChildren()
	) do

		if obj:IsA("ScreenGui")
		and obj.Name ~= "LTDC_STATS" then

			local scale =
				obj:FindFirstChild(
					"LTDC_UIScale"
				)

			if not scale then

				scale =
					Instance.new("UIScale")

				scale.Name =
					"LTDC_UIScale"

				scale.Parent = obj

			end

			scale.Scale = 1.2

			uiScales[obj] = scale

		end

	end

end


local function disableScreen()

	for _,scale in pairs(
		uiScales
	) do

		if scale and scale.Parent then

			scale.Scale = 1

		end

	end

	uiScales = {}

end

--========================================================--
-- PRENDAS
--========================================================--

local function enableClothes()

	for _,plr in ipairs(
		Players:GetPlayers()
	) do

		if plr ~= player
		and plr.Character then

			for _,obj in ipairs(
				plr.Character:GetChildren()
			) do

				if obj:IsA("Accessory")
				or obj:IsA("Hat")
				or obj:IsA("Shirt")
				or obj:IsA("Pants")
				or obj:IsA("ShirtGraphic") then

					if hiddenClothes[obj] == nil then

						hiddenClothes[obj] =
							obj.Parent

					end

					obj.Parent = nil

				end

			end

		end

	end

end


local function disableClothes()

	for obj,parent in pairs(
		hiddenClothes
	) do

		if obj and parent then

			pcall(function()

				obj.Parent = parent

			end)

		end

	end

	hiddenClothes = {}

end

--========================================================--
-- MEMORIA
--========================================================--

local memoryThread = nil


local function enableMemory()

	if memoryThread then
		return
	end

	memoryThread =
		task.spawn(function()

			while states["Memoria"] do

				task.wait(15)

				pcall(function()

					collectgarbage(
						"collect"
					)

				end)

			end

			memoryThread = nil

		end)

end


local function disableMemory()

	states["Memoria"] = false

end

--========================================================--
-- AI OPTIMIZER
--========================================================--

local aiConnection = nil


local function enableAI()

	if aiConnection then
		return
	end

	aiConnection =
		RunService.Heartbeat:Connect(
			function()

				if not states["AI Optimizer"] then
					return
				end

			end
		)

end


local function disableAI()

	if aiConnection then

		aiConnection:Disconnect()

		aiConnection = nil

	end

end

--========================================================--
-- STATIC WORLD
--========================================================--

local function enableStaticWorld()

	for _,obj in ipairs(
		Workspace:GetDescendants()
	) do

		if obj:IsA("BasePart") then

			safeSet(
				obj,
				"AssemblyLinearVelocity",
				Vector3.zero
			)

			safeSet(
				obj,
				"AssemblyAngularVelocity",
				Vector3.zero
			)

		end

	end

end


local function disableStaticWorld()
end

--========================================================--
-- PLAYER ONLY
--========================================================--

local function enablePlayerOnly()

	hiddenWorld = {}

	for _,obj in ipairs(
		Workspace:GetDescendants()
	) do

		if obj:IsA("BasePart") then

			local model =
				obj:FindFirstAncestorOfClass(
					"Model"
				)

			if model
			and model ~= player.Character
			and not model:FindFirstChildOfClass(
				"Humanoid"
			) then

				hiddenWorld[obj] =
					obj.Transparency

				obj.Transparency = 1

			end

		end

	end