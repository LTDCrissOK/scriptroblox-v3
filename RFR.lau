--========================================================-- -- LTDC FLOAT UI - V2.1 -- OPTIMIZACIÓN / ANDROID / TOUCH -- FPS + PING MINI HUD / MENÚ MOVIBLE --========================================================-- local Players = game:GetService("Players") local UserInputService = game:GetService("UserInputService") local RunService = game:GetService("RunService") local Lighting = game:GetService("Lighting") local Workspace = game:GetService("Workspace") local TweenService = game:GetService("TweenService") local Stats = game:GetService("Stats") local player = Players.LocalPlayer --========================================================-- -- ELIMINAR VERSIONES ANTERIORES --========================================================-- pcall(function() 	local parents = { 		game:GetService("CoreGui"), 		player:WaitForChild("PlayerGui") 	} 	for _,parent in ipairs(parents) do 		local old = parent:FindFirstChild("LTDC_UI_V2") 		if old then 			old:Destroy() 		end 		local oldStats = parent:FindFirstChild("LTDC_STATS") 		if oldStats then 			oldStats:Destroy() 		end 	end end) --========================================================-- -- GUI PRINCIPAL --========================================================-- local gui = Instance.new("ScreenGui") gui.Name = "LTDC_UI_V2" gui.ResetOnSpawn = false gui.IgnoreGuiInset = true gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling gui.DisplayOrder = 999999 local function getUIParent() 	local ok, result = pcall(function() 		if typeof(gethui) == "function" then 			return gethui() 		end 	end) 	if ok and result then 		return result 	end 	return game:GetService("CoreGui") end local uiParent = getUIParent() pcall(function() 	gui.Parent = uiParent end) if not gui.Parent then 	gui.Parent = player:WaitForChild("PlayerGui") end --========================================================-- -- ESTADOS --========================================================-- local states = {} local connections = {} local originalLighting = {} local originalEffects = {} local hiddenClothes = {} local hiddenWorld = {} local staticParts = {} local characterEffects = {} local npcEffects = {} local audioObjects = {} local vegetationObjects = {} local uiScales = {} local fpsGui = nil local fpsBox = nil local pingBox = nil local fpsConnection = nil local pingThread = nil local frameCount = 0 local lastFPSTime = tick() local currentFPS = 0 --========================================================-- -- FUNCIONES AUXILIARES --========================================================-- local function disconnect(name) 	if connections[name] then 		pcall(function() 			connections[name]:Disconnect() 		end) 		connections[name] = nil 	end end local function safeSet(object, property, value) 	pcall(function() 		object[property] = value 	end) end local function getCharacter() 	local character = player.Character 	if not character then 		return nil,nil,nil 	end 	local humanoid = 		character:FindFirstChildOfClass("Humanoid") 	local root = 		character:FindFirstChild("HumanoidRootPart") 	return character,humanoid,root end --========================================================-- -- BURBUJA LTDC --========================================================-- local bubble = Instance.new("TextButton") bubble.Name = "LTDC_Bubble" bubble.Size = 	UDim2.new(0,60,0,60) bubble.Position = 	UDim2.new(0.08,0,0.5,0) bubble.BackgroundColor3 = 	Color3.fromRGB(0,0,0) bubble.BackgroundTransparency = 0 bubble.Text = "ltdc" bubble.TextColor3 = 	Color3.fromRGB(255,255,255) bubble.Font = 	Enum.Font.GothamBold bubble.TextSize = 14 bubble.AutoButtonColor = false bubble.Active = true bubble.Selectable = true bubble.ZIndex = 100 bubble.Parent = gui local bubbleCorner = Instance.new("UICorner") bubbleCorner.CornerRadius = 	UDim.new(1,0) bubbleCorner.Parent = bubble local bubbleStroke = Instance.new("UIStroke") bubbleStroke.Color = 	Color3.fromRGB(60,60,60) bubbleStroke.Thickness = 2 bubbleStroke.Parent = bubble --========================================================-- -- MOVER BURBUJA --========================================================-- local bubbleDragging = false local bubbleDragStart local bubbleStartPos local bubbleMoved = false bubble.InputBegan:Connect(function(input) 	if input.UserInputType == 		Enum.UserInputType.Touch 		or input.UserInputType == 		Enum.UserInputType.MouseButton1 then 		bubbleDragging = true 		bubbleMoved = false 		bubbleDragStart = 			input.Position 		bubbleStartPos = 			bubble.Position 	end end) UserInputService.InputChanged:Connect(function(input) 	if not bubbleDragging then 		return 	end 	if input.UserInputType == 		Enum.UserInputType.Touch 		or input.UserInputType == 		Enum.UserInputType.MouseMovement then 		local delta = 			input.Position - bubbleDragStart 		if math.abs(delta.X) > 8 			or math.abs(delta.Y) > 8 then 			bubbleMoved = true 		end 		bubble.Position = 			UDim2.new( 				bubbleStartPos.X.Scale, 				bubbleStartPos.X.Offset + delta.X, 				bubbleStartPos.Y.Scale, 				bubbleStartPos.Y.Offset + delta.Y 			) 	end end) UserInputService.InputEnded:Connect(function(input) 	if input.UserInputType == 		Enum.UserInputType.Touch 		or input.UserInputType == 		Enum.UserInputType.MouseButton1 then 		bubbleDragging = false 	end end) --========================================================-- -- MENÚ --========================================================-- local menu = Instance.new("Frame") menu.Name = "LTDC_Menu" menu.Size = 	UDim2.new(0,260,0,420) menu.Position = 	UDim2.new(0,80,0,120) menu.BackgroundColor3 = 	Color3.fromRGB(10,10,10) menu.BackgroundTransparency = 0 menu.Visible = false menu.Active = true menu.ZIndex = 50 menu.Parent = gui local menuCorner = Instance.new("UICorner") menuCorner.CornerRadius = 	UDim.new(0,14) menuCorner.Parent = menu local menuStroke = Instance.new("UIStroke") menuStroke.Color = 	Color3.fromRGB(45,45,45) menuStroke.Thickness = 1 menuStroke.Parent = menu --========================================================-- -- HEADER --========================================================-- local header = Instance.new("Frame") header.Name = "Header" header.Size = 	UDim2.new(1,0,0,40) header.BackgroundTransparency = 1 header.Active = true header.ZIndex = 55 header.Parent = menu local title = Instance.new("TextLabel") title.Size = 	UDim2.new(1,-50,1,0) title.Position = 	UDim2.new(0,10,0,0) title.BackgroundTransparency = 1 title.Text = 	"Script Optimización V2" title.TextColor3 = 	Color3.fromRGB(255,255,255) title.Font = 	Enum.Font.GothamBold title.TextSize = 14 title.TextXAlignment = 	Enum.TextXAlignment.Left title.ZIndex = 56 title.Parent = header --========================================================-- -- CERRAR --========================================================-- local close = Instance.new("TextButton") close.Size = 	UDim2.new(0,30,0,30) close.Position = 	UDim2.new(1,-35,0.5,-15) close.BackgroundColor3 = 	Color3.fromRGB(30,30,30) close.Text = "X" close.TextColor3 = 	Color3.fromRGB(255,255,255) close.Font = 	Enum.Font.GothamBold close.TextSize = 14 close.AutoButtonColor = false close.Active = true close.ZIndex = 60 close.Parent = header local closeCorner = Instance.new("UICorner") closeCorner.CornerRadius = 	UDim.new(1,0) closeCorner.Parent = close --========================================================-- -- MOVER MENÚ --========================================================-- local menuDragging = false local menuDragStart local menuStartPos header.InputBegan:Connect(function(input) 	if input.UserInputType == 		Enum.UserInputType.Touch 		or input.UserInputType == 		Enum.UserInputType.MouseButton1 then 		menuDragging = true 		menuDragStart = 			input.Position 		menuStartPos = 			menu.Position 	end end) UserInputService.InputChanged:Connect(function(input) 	if not menuDragging then 		return 	end 	if input.UserInputType == 		Enum.UserInputType.Touch 		or input.UserInputType == 		Enum.UserInputType.MouseMovement then 		local delta = 			input.Position - menuDragStart 		menu.Position = 			UDim2.new( 				menuStartPos.X.Scale, 				menuStartPos.X.Offset + delta.X, 				menuStartPos.Y.Scale, 				menuStartPos.Y.Offset + delta.Y 			) 	end end) UserInputService.InputEnded:Connect(function(input) 	if input.UserInputType == 		Enum.UserInputType.Touch 		or input.UserInputType == 		Enum.UserInputType.MouseButton1 then 		menuDragging = false 	end end) --========================================================-- -- CONTENEDOR --========================================================-- local container = Instance.new("Frame") container.Size = 	UDim2.new(1,-20,1,-90) container.Position = 	UDim2.new(0,10,0,45) container.BackgroundColor3 = 	Color3.fromRGB(15,15,15) container.ZIndex = 51 container.Parent = menu local containerCorner = Instance.new("UICorner") containerCorner.CornerRadius = 	UDim.new(0,10) containerCorner.Parent = container --========================================================-- -- SCROLL --========================================================-- local Scroll = Instance.new("ScrollingFrame") Scroll.Size = 	UDim2.new(1,-10,1,-10) Scroll.Position = 	UDim2.new(0,5,0,5) Scroll.BackgroundTransparency = 1 Scroll.BorderSizePixel = 0 Scroll.ScrollBarThickness = 0 Scroll.CanvasSize = 	UDim2.new(0,0,0,0) Scroll.ZIndex = 52 Scroll.Parent = container local layout = 	Instance.new("UIListLayout") layout.Padding = 	UDim.new(0,6) layout.SortOrder = 	Enum.SortOrder.LayoutOrder layout.Parent = Scroll layout:GetPropertyChangedSignal( 	"AbsoluteContentSize" ):Connect(function() 	Scroll.CanvasSize = 		UDim2.new( 			0, 			0, 			0, 			layout.AbsoluteContentSize.Y + 15 		) end) --========================================================-- -- FOOTER --========================================================-- local footer = Instance.new("TextLabel") footer.Size = 	UDim2.new(1,0,0,30) footer.Position = 	UDim2.new(0,0,1,-30) footer.BackgroundTransparency = 1 footer.Text = 	"Script hecho por ltdc" footer.TextColor3 = 	Color3.fromRGB(140,140,140) footer.Font = 	Enum.Font.Gotham footer.TextSize = 12 footer.ZIndex = 52 footer.Parent = menu --========================================================-- -- OPTIMIZACIÓN --========================================================-- local function saveLighting() 	if next(originalLighting) ~= nil then 		return 	end 	originalLighting.GlobalShadows = 		Lighting.GlobalShadows 	originalLighting.Brightness = 		Lighting.Brightness 	originalLighting.Ambient = 		Lighting.Ambient 	originalLighting.OutdoorAmbient = 		Lighting.OutdoorAmbient 	originalLighting.ClockTime = 		Lighting.ClockTime 	originalLighting.FogEnd = 		Lighting.FogEnd 	pcall(function() 		originalLighting.Technology = 			Lighting.Technology 	end) end local function enableOptimization() 	saveLighting() 	safeSet( 		Lighting, 		"GlobalShadows", 		false 	) 	safeSet( 		Lighting, 		"FogEnd", 		100000 	) 	pcall(function() 		Lighting.Technology = 			Enum.Technology.Compatibility 	end) 	pcall(function() 		settings().Rendering.QualityLevel = 			Enum.QualityLevel.Level01 	end) 	for _,obj in ipairs( 		Lighting:GetDescendants() 	) do 		if obj:IsA("BloomEffect") 		or obj:IsA("BlurEffect") 		or obj:IsA("ColorCorrectionEffect") 		or obj:IsA("DepthOfFieldEffect") 		or obj:IsA("SunRaysEffect") then 			if originalEffects[obj] == nil then 				originalEffects[obj] = 					obj.Enabled 			end 			obj.Enabled = false 		end 	end end local function disableOptimization() 	for property,value in pairs( 		originalLighting 	) do 		safeSet( 			Lighting, 			property, 			value 		) 	end 	for obj,value in pairs( 		originalEffects 	) do 		if obj and obj.Parent then 			safeSet( 				obj, 				"Enabled", 				value 			) 		end 	end 	pcall(function() 		settings().Rendering.QualityLevel = 			Enum.QualityLevel.Automatic 	end) end --========================================================-- -- FPS / PING --========================================================-- local function createStatsGUI() 	if fpsGui then 		return 	end 	fpsGui = Instance.new("ScreenGui") 	fpsGui.Name = 		"LTDC_STATS" 	fpsGui.ResetOnSpawn = false 	fpsGui.IgnoreGuiInset = true 	fpsGui.DisplayOrder = 		999998 	fpsGui.ZIndexBehavior = 		Enum.ZIndexBehavior.Sibling 	fpsGui.Parent = 		player:WaitForChild("PlayerGui") 	-- FPS 	fpsBox = Instance.new("TextButton") 	fpsBox.Name = "FPS" 	fpsBox.Size = 		UDim2.new(0,105,0,28) 	fpsBox.Position = 		UDim2.new(1,-115,0,10) 	fpsBox.BackgroundColor3 = 		Color3.fromRGB(0,0,0) 	fpsBox.BackgroundTransparency = 		0.28 	fpsBox.Text = "FPS" 	fpsBox.TextColor3 = 		Color3.fromRGB(255,255,255) 	fpsBox.Font = 		Enum.Font.GothamBold 	fpsBox.TextSize = 12 	fpsBox.AutoButtonColor = false 	fpsBox.Active = true 	fpsBox.Parent = fpsGui 	local c1 = 		Instance.new("UICorner") 	c1.CornerRadius = 		UDim.new(0,7) 	c1.Parent = fpsBox 	-- PING 	pingBox = Instance.new("TextButton") 	pingBox.Name = "PING" 	pingBox.Size = 		UDim2.new(0,105,0,28) 	pingBox.Position = 		UDim2.new(1,-115,0,43) 	pingBox.BackgroundColor3 = 		Color3.fromRGB(0,0,0) 	pingBox.BackgroundTransparency = 		0.28 	pingBox.Text = "PING" 	pingBox.TextColor3 = 		Color3.fromRGB(255,255,255) 	pingBox.Font = 		Enum.Font.GothamBold 	pingBox.TextSize = 12 	pingBox.AutoButtonColor = false 	pingBox.Active = true 	pingBox.Visible = false 	pingBox.Parent = fpsGui 	local c2 = 		Instance.new("UICorner") 	c2.CornerRadius = 		UDim.new(0,7) 	c2.Parent = pingBox end local function enableFPS() 	createStatsGUI() 	fpsBox.Visible = true 	states["FPS"] = true 	frameCount = 0 	lastFPSTime = tick() 	if fpsConnection then 		fpsConnection:Disconnect() 	end 	fpsConnection = 		RunService.RenderStepped:Connect( 			function() 				if not states["FPS"] then 					return 				end 				frameCount += 1 				local now = tick() 				if now-lastFPSTime >= 0.5 then 					currentFPS = 						math.floor( 							frameCount / 							(now-lastFPSTime) 						) 					fpsBox.Text = 						"FPS "..currentFPS 					frameCount = 0 					lastFPSTime = now 				end 			end 		) end local function disableFPS() 	states["FPS"] = false 	if fpsConnection then 		fpsConnection:Disconnect() 		fpsConnection = nil 	end 	if fpsBox then 		fpsBox.Text = "FPS" 		fpsBox.Visible = false 	end end local function getPing() 	local ping = 0 	pcall(function() 		local serverStats = 			Stats.Network.ServerStatsItem 		local dataPing = 			serverStats:FindFirstChild( 				"Data Ping" 			) 		if dataPing then 			ping = 				math.floor( 					dataPing:GetValue() 				) 		end 	end) 	return ping end local function enablePing() 	createStatsGUI() 	pingBox.Visible = true 	states["Ping Monitor"] = true 	pingBox.Text = "PING ..." 	if pingThread then 		return 	end 	pingThread = 		task.spawn(function() 			while states["Ping Monitor"] do 				local ping = 					getPing() 				if ping > 0 then 					pingBox.Text = 						"PING "..ping.." ms" 				else 					pingBox.Text = 						"PING ..." 				end 				task.wait(1) 			end 			pingThread = nil 		end) end local function disablePing() 	states["Ping Monitor"] = false 	if pingBox then 		pingBox.Text = "PING" 		pingBox.Visible = false 	end end --========================================================-- -- PANTALLA --========================================================-- local function enableScreen() 	for _,obj in ipairs( 		player.PlayerGui:GetChildren() 	) do 		if obj:IsA("ScreenGui") 		and obj.Name ~= "LTDC_STATS" then 			local scale = 				obj:FindFirstChild( 					"LTDC_UIScale" 				) 			if not scale then 				scale = 					Instance.new("UIScale") 				scale.Name = 					"LTDC_UIScale" 				scale.Parent = obj 			end 			scale.Scale = 1.2 			uiScales[obj] = scale 		end 	end end local function disableScreen() 	for _,scale in pairs( 		uiScales 	) do 		if scale and scale.Parent then 			scale.Scale = 1 		end 	end 	uiScales = {} end --========================================================-- -- PRENDAS --========================================================-- local function enableClothes() 	for _,plr in ipairs( 		Players:GetPlayers() 	) do 		if plr ~= player 		and plr.Character then 			for _,obj in ipairs( 				plr.Character:GetChildren() 			) do 				if obj:IsA("Accessory") 				or obj:IsA("Hat") 				or obj:IsA("Shirt") 				or obj:IsA("Pants") 				or obj:IsA("ShirtGraphic") then 					if hiddenClothes[obj] == nil then 						hiddenClothes[obj] = 							obj.Parent 					end 					obj.Parent = nil 				end 			end 		end 	end end local function disableClothes() 	for obj,parent in pairs( 		hiddenClothes 	) do 		if obj and parent then 			pcall(function() 				obj.Parent = parent 			end) 		end 	end 	hiddenClothes = {} end --========================================================-- -- MEMORIA --========================================================-- local memoryThread local function enableMemory() 	if memoryThread then 		return 	end 	memoryThread = 		task.spawn(function() 			while states["Memoria"] do 				task.wait(15) 				pcall(function() 					collectgarbage("collect") 				end) 			end 			memoryThread = nil 		end) end local function disableMemory() 	states["Memoria"] = false end --========================================================-- -- AI OPTIMIZER --========================================================-- local aiConnection local function enableAI() 	if aiConnection then 		return 	end 	aiConnection = 		RunService.Heartbeat:Connect( 			function() 				if not states["AI Optimizer"] then 					return 				end 				-- Supervisión ligera. 				-- No cambia la calidad cada frame. 			end 		) end local function disableAI() 	if aiConnection then 		aiConnection:Disconnect() 		aiConnection = nil 	end end --========================================================-- -- STATIC WORLD --========================================================-- local function enableStaticWorld() 	staticParts = {} 	for _,obj in ipairs( 		Workspace:GetDescendants() 	) do 		if obj:IsA("BasePart") then 			staticParts[obj] = { 				Linear = 					obj.AssemblyLinearVelocity, 				Angular = 					obj.AssemblyAngularVelocity 			} 			safeSet( 				obj, 				"AssemblyLinearVelocity", 				Vector3.zero 			) 			safeSet( 				obj, 				"AssemblyAngularVelocity", 				Vector3.zero 			) 		end 	end end local function disableStaticWorld() 	for obj,data in pairs( 		staticParts 	) do 		if obj and obj.Parent then 			safeSet( 				obj, 				"AssemblyLinearVelocity", 				data.Linear 			) 			safeSet( 				obj, 				"AssemblyAngularVelocity", 				data.Angular 			) 		end 	end 	staticParts = {} end --========================================================-- -- PLAYER ONLY --========================================================-- local function enablePlayerOnly() 	hiddenWorld = {} 	for _,obj in ipairs( 		Workspace:GetDescendants() 	) do 		if obj:IsA("BasePart") then 			local model = 				obj:FindFirstAncestorOfClass( 					"Model" 				) 			if model 			and model ~= player.Character 			and not model:FindFirstChildOfClass( 				"Humanoid" 			) then 				hiddenWorld[obj] = 					obj.Transparency 				obj.Transparency = 1 			end 		end 	end end local function disablePlayerOnly() 	for obj,value in pairs( 		hiddenWorld 	) do 		if obj and obj.Parent then 			obj.Transparency = value 		end 	end 	hiddenWorld = {} end --========================================================-- -- MEMORY GUARD --========================================================-- local memoryGuardConnection local function enableMemoryGuard() 	if memoryGuardConnection then 		return 	end 	memoryGuardConnection = 		RunService.Heartbeat:Connect( 			function() 				if not states["Memory Guard"] then 					return 				end 				local memory = 					collectgarbage("count") 				if memory > 300000 then 					pcall(function() 						collectgarbage("collect") 					end) 				end 			end 		) end local function disableMemoryGuard() 	if memoryGuardConnection then 		memoryGuardConnection:Disconnect() 		memoryGuardConnection = nil 	end end --========================================================-- -- STARTUP OPTIMIZER --========================================================-- local function enableStartupOptimizer() 	-- Preparación ligera del cliente. 	-- No intenta modificar el servidor. end local function disableStartupOptimizer() end --========================================================-- -- BACKGROUND MODE --========================================================-- local function enableBackgroundMode() 	-- Mantiene el estado del cliente sin 	-- ejecutar tareas pesadas adicionales. end local function disableBackgroundMode() end --========================================================-- -- CONNECTION MANAGER --========================================================-- local function enableConnectionManager() 	-- Limpieza de conexiones internas de este script. 	-- No modifica conexiones de Roblox. end local function disableConnectionManager() end --========================================================-- -- INPUT OPTIMIZER --========================================================-- local function enableInputOptimizer() 	-- Evita crear conexiones adicionales 	-- innecesarias. El input original permanece. end local function disableInputOptimizer() end --========================================================-- -- CAMERA OPTIMIZER --========================================================-- local originalCameraFOV = nil local function enableCameraOptimizer() 	local camera = 		Workspace.CurrentCamera 	if camera then 		if originalCameraFOV == nil then 			originalCameraFOV = 				camera.FieldOfView 		end 		-- No modifica drásticamente el FOV. 		-- Solo conserva el valor original. 	end end local function disableCameraOptimizer() 	if originalCameraFOV then 		local camera = 			Workspace.CurrentCamera 		if camera then 			safeSet( 				camera, 				"FieldOfView", 				originalCameraFOV 			) 		end 	end 	originalCameraFOV = nil end --========================================================-- -- NET STABILIZER --========================================================-- local function enableNetStabilizer() 	-- El cliente no puede cambiar el ping real 	-- ni controlar la red del servidor. 	-- Esta opción queda como modo seguro. end local function disableNetStabilizer() end --========================================================-- -- DYNAMIC SLEEP --========================================================-- local dynamicConnection local function enableDynamicSleep() 	if dynamicConnection then 		return 	end 	dynamicConnection = 		RunService.Heartbeat:Connect( 			function() 				if not states["Dynamic Sleep"] then 					return 				end 				-- Sin tareas pesadas. 				-- Se mantiene intencionalmente ligero. 			end 		) end local function disableDynamicSleep() 	if dynamicConnection then 		dynamicConnection:Disconnect() 		dynamicConnection = nil 	end end --========================================================-- -- CHARACTER OPTIMIZER --========================================================-- local function optimizeCharacter(character) 	if not character then 		return 	end 	for _,obj in ipairs( 		character:GetDescendants() 	) do 		if obj:IsA("ParticleEmitter") 		or obj:IsA("Trail") 		or obj:IsA("Beam") then 			if characterEffects[obj] == nil then 				characterEffects[obj] = 					obj.Enabled 			end 			obj.Enabled = false 		end 	end end local function enableCharacterOptimizer() 	if player.Character then 		optimizeCharacter( 			player.Character 		) 	end 	disconnect( 		"CharacterOptimizer" 	) 	connections[ 		"CharacterOptimizer" 	] = 		player.CharacterAdded:Connect( 			function(character) 				task.wait(1) 				if states[ 					"Character Optimizer" 				] then 					optimizeCharacter( 						character 					) 				end 			end 		) end local function disableCharacterOptimizer() 	disconnect( 		"CharacterOptimizer" 	) 	for obj,value in pairs( 		characterEffects 	) do 		if obj and obj.Parent then 			safeSet( 				obj, 				"Enabled", 				value 			) 		end 	end 	characterEffects = {} end --========================================================-- -- NPC OPTIMIZER --========================================================-- local function isNPC(model) 	if not model:IsA("Model") then 		return false 	end 	local humanoid = 		model:FindFirstChildOfClass( 			"Humanoid" 		) 	if not humanoid then 		return false 	end 	return Players:GetPlayerFromCharacter( 		model 	) == nil end local function optimizeNPC(model) 	if not isNPC(model) then 		return 	end 	for _,obj in ipairs( 		model:GetDescendants() 	) do 		if obj:IsA("ParticleEmitter") 		or obj:IsA("Trail") 		or obj:IsA("Beam") then 			if npcEffects[obj] == nil then 				npcEffects[obj] = 					obj.Enabled 			end 			obj.Enabled = false 		end 	end end local function enableNPCOptimizer() 	for _,obj in ipairs( 		Workspace:GetDescendants() 	) do 		if obj:IsA("Model") 		and isNPC(obj) then 			optimizeNPC(obj) 		end 	end 	disconnect("NPCOptimizer") 	connections[ 		"NPCOptimizer" 	] = 		Workspace.DescendantAdded:Connect( 			function(obj) 				if states[ 					"NPC Optimizer" 				] 				and obj:IsA("Model") 				and isNPC(obj) then 					task.wait(0.2) 					optimizeNPC(obj) 				end 			end 		) end local function disableNPCOptimizer() 	disconnect("NPCOptimizer") 	for obj,value in pairs( 		npcEffects 	) do 		if obj and obj.Parent then 			safeSet( 				obj, 				"Enabled", 				value 			) 		end 	end 	npcEffects = {} end --========================================================-- -- AUDIO OPTIMIZER --========================================================-- local function enableAudioOptimizer() 	for _,obj in ipairs( 		Workspace:GetDescendants() 	) do 		if obj:IsA("Sound") then 			if audioObjects[obj] == nil then 				audioObjects[obj] = 					obj.Volume 			end 			if obj.Volume > 0.5 then 				obj.Volume = 0.5 			end 		end 	end end local function disableAudioOptimizer() 	for obj,value in pairs( 		audioObjects 	) do 		if obj and obj.Parent then 			safeSet( 				obj, 				"Volume", 				value 			) 		end 	end 	audioObjects = {} end --========================================================-- -- VEGETATION / PARTICLES --========================================================-- local function enableVegetationOptimizer() 	for _,obj in ipairs( 		Workspace:GetDescendants() 	) do 		if obj:IsA("ParticleEmitter") then 			if vegetationObjects[obj] == nil then 				vegetationObjects[obj] = 					obj.Enabled 			end 			obj.Enabled = false 		end 	end end local function disableVegetationOptimizer() 	for obj,value in pairs( 		vegetationObjects 	) do 		if obj and obj.Parent then 			safeSet( 				obj, 				"Enabled", 				value 			) 		end 	end 	vegetationObjects = {} end --========================================================-- -- STREAMING HELPER --========================================================-- local function enableStreamingHelper() 	local character,humanoid,root = 		getCharacter() 	if root then 		pcall(function() 			player:RequestStreamAroundAsync( 				root.Position 			) 		end) 	end end local function disableStreamingHelper() end --========================================================-- -- TOGGLES --========================================================-- local toggleButtons = {} local toggleCallbacks = {} local function updateToggleVisual(name) 	local button = 		toggleButtons[name] 	if not button then 		return 	end 	if states[name] then 		button.Text = 			name.." [ ON ]" 		button.TextColor3 = 			Color3.fromRGB( 				255, 				255, 				255 			) 		button.BackgroundColor3 = 			Color3.fromRGB( 				35, 				35, 				35 			) 		-- El estado ON queda marcado en verde 		-- mediante un pequeño indicador lateral. 		local indicator = 			button:FindFirstChild( 				"LTDC_Status" 			) 		if indicator then 			indicator.BackgroundColor3 = 				Color3.fromRGB( 					0, 					255, 					100 				) 		end 	else 		button.Text = 			name.." [ OFF ]" 		button.BackgroundColor3 = 			Color3.fromRGB( 				25, 				25, 				25 			) 		local indicator = 			button:FindFirstChild( 				"LTDC_Status" 			) 		if indicator then 			indicator.BackgroundColor3 = 				Color3.fromRGB( 					255, 					50, 					50 				) 		end 	end end local function setToggle(name,value) 	states[name] = value 	updateToggleVisual(name) 	local callback = 		toggleCallbacks[name] 	if callback then 		pcall(function() 			callback(value) 		end) 	end end local function createToggle(name,callback) 	local button = 		Instance.new("TextButton") 	button.Name = 		"Toggle_"..name 	button.Size = 		UDim2.new(1,-8,0,40) 	button.BackgroundColor3 = 		Color3.fromRGB( 			25, 			25, 			25 		) 	button.Text = 		name.." [ OFF ]" 	button.TextColor3 = 		Color3.fromRGB( 			255, 			255, 			255 		) 	button.Font = 		Enum.Font.GothamBold 	button.TextSize = 12 	button.AutoButtonColor = false 	button.Active = true 	button.ZIndex = 53 	button.Parent = Scroll 	local corner = 		Instance.new("UICorner") 	corner.CornerRadius = 		UDim.new(0,9) 	corner.Parent = button 	local stroke = 		Instance.new("UIStroke") 	stroke.Color = 		Color3.fromRGB( 			50, 			50, 			50 		) 	stroke.Thickness = 1 	stroke.Parent = button 	-- Indicador pequeño, 	-- no es una pelota ni cambia el diseño. 	local indicator = 		Instance.new("Frame") 	indicator.Name = 		"LTDC_Status" 	indicator.Size = 		UDim2.new(0,4,0,22) 	indicator.Position = 		UDim2.new(1,-7,0.5,-11) 	indicator.BackgroundColor3 = 		Color3.fromRGB( 			255, 			50, 			50 		) 	indicator.BorderSizePixel = 0 	indicator.ZIndex = 54 	indicator.Parent = button 	local ic = 		Instance.new("UICorner") 	ic.CornerRadius = 		UDim.new(1,0) 	ic.Parent = indicator 	states[name] = false 	toggleButtons[name] = button 	toggleCallbacks[name] = callback 	button.Activated:Connect(function() 		setToggle( 			name, 			not states[name] 		) 	end) end --========================================================-- -- ALL OPTIONS --========================================================-- local allButton = 	Instance.new("TextButton") allButton.Name = 	"ALL_OPTIONS" allButton.Size = 	UDim2.new(1,-8,0,42) allButton.BackgroundColor3 = 	Color3.fromRGB( 		20, 		20, 		20 	) allButton.Text = 	"ALL OPTIONS" allButton.TextColor3 = 	Color3.fromRGB( 		255, 		255, 		255 	) allButton.Font = 	Enum.Font.GothamBold allButton.TextSize = 13 allButton.AutoButtonColor = false allButton.Active = true allButton.ZIndex = 54 allButton.Parent = Scroll local allCorner = 	Instance.new("UICorner") allCorner.CornerRadius = 	UDim.new(0,9) allCorner.Parent = allButton local allStroke = 	Instance.new("UIStroke") allStroke.Color = 	Color3.fromRGB( 		70, 		70, 		70 	) allStroke.Thickness = 1 allStroke.Parent = allButton --========================================================-- -- OPCIONES ORIGINALES --========================================================-- createToggle( 	"Optimización", 	function(on) 		if on then 			enableOptimization() 		else 			disableOptimization() 		end 	end ) createToggle( 	"FPS", 	function(on) 		if on then 			enableFPS() 		else 			disableFPS() 		end 	end ) createToggle( 	"Pantalla", 	function(on) 		if on then 			enableScreen() 		else 			disableScreen() 		end 	end ) createToggle( 	"Prendas", 	function(on) 		if on then 			enableClothes() 		else 			disableClothes() 		end 	end ) createToggle( 	"Memoria", 	function(on) 		if on then 			enableMemory() 		else 			disableMemory() 		end 	end ) createToggle( 	"AI Optimizer", 	function(on) 		if on then 			enableAI() 		else 			disableAI() 		end 	end ) createToggle( 	"Static World", 	function(on) 		if on then 			enableStaticWorld() 		else 			disableStaticWorld() 		end 	end ) createToggle( 	"Player Only", 	function(on) 		if on then 			enablePlayerOnly() 		else 			disablePlayerOnly() 		end 	end ) createToggle( 	"Memory Guard", 	function(on) 		if on then 			enableMemoryGuard() 		else 			disableMemoryGuard() 		end 	end ) createToggle( 	"Net Stabilizer", 	function(on) 		if on then 			enableNetStabilizer() 		else 			disableNetStabilizer() 		end 	end ) createToggle( 	"Dynamic Sleep", 	function(on) 		if on then 			enableDynamicSleep() 		else 			disableDynamicSleep() 		end 	end ) createToggle( 	"Startup Optimizer", 	function(on) 		if on then 			enableStartupOptimizer() 		else 			disableStartupOptimizer() 		end 	end ) createToggle( 	"Background Mode", 	function(on) 		if on then 			enableBackgroundMode() 		else 			disableBackgroundMode() 		end 	end ) createToggle( 	"Connection Manager", 	function(on) 		if on then 			enableConnectionManager() 		else 			disableConnectionManager() 		end 	end ) createToggle( 	"Character Optimizer", 	function(on) 		if on then 			enableCharacterOptimizer() 		else 			disableCharacterOptimizer() 		end 	end ) createToggle( 	"NPC Optimizer", 	function(on) 		if on then 			enableNPCOptimizer() 		else 			disableNPCOptimizer() 		end 	end ) createToggle( 	"Input Optimizer", 	function(on) 		if on then 			enableInputOptimizer() 		else 			disableInputOptimizer() 		end 	end ) createToggle( 	"Audio Optimizer", 	function(on) 		if on then 			enableAudioOptimizer() 		else 			disableAudioOptimizer() 		end 	end ) createToggle( 	"Camera Optimizer", 	function(on) 		if on then 			enableCameraOptimizer() 		else 			disableCameraOptimizer() 		end 	end ) createToggle( 	"Vegetation Optimizer", 	function(on) 		if on then 			enableVegetationOptimizer() 		else 			disableVegetationOptimizer() 		end 	end ) createToggle( 	"Streaming Helper", 	function(on) 		if on then 			enableStreamingHelper() 		else 			disableStreamingHelper() 		end 	end ) createToggle( 	"Ping Monitor", 	function(on) 		if on then 			enablePing() 		else 			disablePing() 		end 	end ) --========================================================-- -- ALL OPTIONS -- FPS Y PING NO SE INCLUYEN --========================================================-- local optimizationOptions = { 	"Optimización", 	"Pantalla", 	"Prendas", 	"Memoria", 	"AI Optimizer", 	"Static World", 	"Player Only", 	"Memory Guard", 	"Net Stabilizer", 	"Dynamic Sleep", 	"Startup Optimizer", 	"Background Mode", 	"Connection Manager", 	"Character Optimizer", 	"NPC Optimizer", 	"Input Optimizer", 	"Audio Optimizer", 	"Camera Optimizer", 	"Vegetation Optimizer", 	"Streaming Helper" } allButton.Activated:Connect(function() 	for _,name in ipairs( 		optimizationOptions 	) do 		if not states[name] then 			setToggle( 				name, 				true 			) 		end 	end 	allButton.Text = 		"ALL OPTIONS ✓" 	allButton.BackgroundColor3 = 		Color3.fromRGB( 			35, 			35, 			35 		) 	task.delay( 		0.5, 		function() 			if allButton 			and allButton.Parent then 				allButton.Text = 					"ALL OPTIONS" 				allButton.BackgroundColor3 = 					Color3.fromRGB( 						20, 						20, 						20 					) 			end 		end 	) end) --========================================================-- -- ABRIR MENÚ --========================================================-- bubble.Activated:Connect(function() 	if bubbleMoved then 		bubbleMoved = false 		return 	end 	bubble.Visible = false 	menu.Visible = true 	menu.Size = 		UDim2.new(0,0,0,0) 	local tween = 		TweenService:Create( 			menu, 			TweenInfo.new( 				0.25, 				Enum.EasingStyle.Quad, 				Enum.EasingDirection.Out 			), 			{ 				Size = 					UDim2.new( 						0, 						260, 						0, 						420 					) 			} 		) 	tween:Play() end) --========================================================-- -- CERRAR MENÚ --========================================================-- close.Activated:Connect(function() 	local tween = 		TweenService:Create( 			menu, 			TweenInfo.new( 				0.20, 				Enum.EasingStyle.Quad, 				Enum.EasingDirection.In 			), 			{ 				Size = 					UDim2.new( 						0, 						0, 						0, 						0 					) 			} 		) 	tween:Play() 	tween.Completed:Connect( 		function() 			menu.Visible = false 			bubble.Visible = true 		end 	) end) --========================================================-- -- RESPAWN --========================================================-- player.CharacterAdded:Connect( 	function(character) 		task.wait(1) 		-- Las opciones permanecen ON. 		-- Solo se reaplican los efectos 		-- que corresponden al nuevo personaje. 		if states[ 			"Character Optimizer" 		] then 			pcall(function() 				optimizeCharacter(character) 			end) 		end 		if states[ 			"Streaming Helper" 		] then 			pcall(function() 				local root = 					character:FindFirstChild( 						"HumanoidRootPart" 					) 				if root then 					player: 						RequestStreamAroundAsync( 							root.Position 						) 				end 			end) 		end 	end ) --========================================================-- -- FINAL --========================================================-- print( 	"========================================" ) print( 	" LTDC FLOAT UI V2.1" ) print( 	"========================================" ) print( 	"Android / Touch: ACTIVO" ) print( 	"Burbuja movible: ACTIVO" ) print( 	"Menu movible: ACTIVO" ) print( 	"ALL OPTIONS: ACTIVO" ) print( 	"FPS independiente: ACTIVO" ) print( 	"Ping independiente: ACTIVO" ) print( 	"========================================" )