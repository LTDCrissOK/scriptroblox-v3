--========================================================--
-- SWITCH
--========================================================--

local function SetSwitch(Name,Enabled)

	State[Name] = Enabled

	local Object =
		ToggleObjects[Name]

	if not Object then
		return
	end

	if Enabled then

		Object.Switch.BackgroundColor3 =
			Color3.fromRGB(35,180,80)

		Object.Knob.Position =
			UDim2.new(1,-23,0.5,-9)

	else

		Object.Switch.BackgroundColor3 =
			Color3.fromRGB(190,45,45)

		Object.Knob.Position =
			UDim2.new(0,5,0.5,-9)

	end

	local Callback =
		Object.Callback

	if Callback then

		pcall(function()

			Callback(Enabled)

		end)

	end

end

