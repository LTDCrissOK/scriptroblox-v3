--========================================================--
-- AUDIO
--========================================================--

local function EnableAudio()

	for _,Object in ipairs(
		Workspace:GetDescendants()
	) do

		if Object:IsA("Sound") then

			if AudioObjects[Object] == nil then

				AudioObjects[Object] =
					Object.Volume

			end

			if Object.Volume > 0.5 then

				Object.Volume = 0.5

			end

		end

	end

end

local function DisableAudio()

	for Object,Value in pairs(
		AudioObjects
	) do

		if Object and Object.Parent then

			Object.Volume = Value

		end

	end

	AudioObjects = {}

end

