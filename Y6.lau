-- GUI
--========================================================--

local PlayerGui = Player:WaitForChild("PlayerGui")

pcall(function()
	local old = PlayerGui:FindFirstChild("LTDC_FLOAT_UI")
	if old then
		old:Destroy()
	end
end)

pcall(function()
	local old = PlayerGui:FindFirstChild("LTDC_STATS_UI")
	if old then
		old:Destroy()
	end
end)

