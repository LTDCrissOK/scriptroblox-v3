		return
	end

	FPSGui = Instance.new("ScreenGui")

	FPSGui.Name = "LTDC_STATS_UI"
	FPSGui.ResetOnSpawn = false
	FPSGui.IgnoreGuiInset = true
	FPSGui.DisplayOrder = 999998

	FPSGui.Parent = PlayerGui

	-- FPS

	FPSBox = Instance.new("TextButton")

	FPSBox.Size = UDim2.fromOffset(105,28)
	FPSBox.Position = UDim2.new(1,-115,0,10)

	FPSBox.BackgroundColor3 = Color3.fromRGB(0,0,0)
	FPSBox.BackgroundTransparency = 0.28

	FPSBox.Text = "FPS  ..."
	FPSBox.TextColor3 = Color3.fromRGB(255,255,255)

	FPSBox.Font = Enum.Font.GothamBold
	FPSBox.TextSize = 12

	FPSBox.AutoButtonColor = false
	FPSBox.Visible = false
	FPSBox.ZIndex = 1000

	FPSBox.Parent = FPSGui

	local FC = Instance.new("UICorner")
	FC.CornerRadius = UDim.new(0,7)
	FC.Parent = FPSBox

	-- PING

	PingBox = Instance.new("TextButton")

	PingBox.Size = UDim2.fromOffset(105,28)
	PingBox.Position = UDim2.new(1,-115,0,43)

	PingBox.BackgroundColor3 = Color3.fromRGB(0,0,0)
	PingBox.BackgroundTransparency = 0.28

	PingBox.Text = "PING  ..."
	PingBox.TextColor3 = Color3.fromRGB(255,255,255)

	PingBox.Font = Enum.Font.GothamBold
	PingBox.TextSize = 12

	PingBox.AutoButtonColor = false
	PingBox.Visible = false
	PingBox.ZIndex = 1000

	PingBox.Parent = FPSGui

	local PC = Instance.new("UICorner")
	PC.CornerRadius = UDim.new(0,7)
	PC.Parent = PingBox

end

--========================================================--
-- FPS
--========================================================--

local function EnableFPS()

	CreateStats()

	State.FPS = true

	FPSBox.Visible = true
	FPSBox.Text = "FPS  ..."

	FrameCount = 0
	LastFPSTime = os.clock()

	if FPSConnection then
		return
	end

	FPSConnection = RunService.RenderStepped:Connect(function()

		if not State.FPS then
			return
		end

		FrameCount += 1

		local Now = os.clock()

		if Now - LastFPSTime >= 0.5 then

			local FPS =
				math.floor(
					FrameCount /
					(Now - LastFPSTime)
				)

			FPSBox.Text = "FPS  "..FPS

			FrameCount = 0
			LastFPSTime = Now

		end

	end)

end

local function DisableFPS()

	State.FPS = false

	if FPSConnection then

		FPSConnection:Disconnect()
		FPSConnection = nil

	end

	if FPSBox then

		FPSBox.Visible = false

	end

end

--========================================================--
-- PING
--========================================================--

local function GetPing()

	local Ping = 0

	pcall(function()

		local Network =
			Stats.Network

		local Server =
			Network.ServerStatsItem

		local Item =
			Server:FindFirstChild("Data Ping")

		if Item then

			Ping =
				math.floor(
					Item:GetValue()
				)

		end

	end)

	return Ping

end

local function EnablePing()

	CreateStats()

	State.Ping = true

	PingBox.Visible = true
	PingBox.Text = "PING  ..."

	if PingThread then
		return
	end

	PingThread = task.spawn(function()

		while State.Ping do

			local Ping = GetPing()

			PingBox.Text =
				"PING  "..Ping.." ms"

			task.wait(1)

		end

		PingThread = nil

	end)

end

local function DisablePing()

	State.Ping = false

	if PingBox then

		PingBox.Visible = false

	end

end

--========================================================--
-- OPTIMIZACIÓN
--========================================================--

local function EnableOptimization()

	if next(OriginalLighting) == nil then

		OriginalLighting.GlobalShadows =
			Lighting.GlobalShadows

		OriginalLighting.Brightness =
			Lighting.Brightness

		OriginalLighting.Ambient =
			Lighting.Ambient

		OriginalLighting.OutdoorAmbient =
			Lighting.OutdoorAmbient

		OriginalLighting.FogEnd =
			Lighting.FogEnd

	end

	SafeSet(
		Lighting,
		"GlobalShadows",
		false
	)

	SafeSet(
		Lighting,
		"FogEnd",
		100000
	)

	pcall(function()

		settings().Rendering.QualityLevel =
			Enum.QualityLevel.Level01

	end)

	for _,Object in ipairs(
		Lighting:GetDescendants()
	) do

		if Object:IsA("BloomEffect")
		or Object:IsA("BlurEffect")
		or Object:IsA("ColorCorrectionEffect")
		or Object:IsA("DepthOfFieldEffect")
		or Object:IsA("SunRaysEffect") then

			if OriginalEffects[Object] == nil then

				OriginalEffects[Object] =
					Object.Enabled

			end

			Object.Enabled = false

		end

	end

end

local function DisableOptimization()

	for Property,Value in pairs(
		OriginalLighting
	) do

		SafeSet(
			Lighting,
			Property,
			Value
		)

	end

	for Object,Value in pairs(
		OriginalEffects
	) do

		if Object and Object.Parent then

			SafeSet(
				Object,
				"Enabled",
				Value
			)

		end

	end

end

--========================================================--
-- PANTALLA
--========================================================--

local function EnableScreen()

	for _,Object in ipairs(
		PlayerGui:GetChildren()
	) do

		if Object:IsA("ScreenGui")
		and Object ~= GUI
		and Object ~= FPSGui then

			local Scale =
				Object:FindFirstChild(
					"LTDC_SCALE"
				)

			if not Scale then

				Scale =
					Instance.new("UIScale")

				Scale.Name =
					"LTDC_SCALE"

				Scale.Parent =
					Object

			end

			Scale.Scale = 1.2

			uiScales[Object] =
				Scale

		end

	end

end

local function DisableScreen()

	for _,Scale in pairs(uiScales) do

		if Scale and Scale.Parent then

			Scale.Scale = 1

		end

	end

	uiScales = {}

end

--========================================================--
-- PRENDAS
--========================================================--

local function EnableClothes()

	for _,OtherPlayer in ipairs(
		Players:GetPlayers()
	) do

		if OtherPlayer ~= Player
		and OtherPlayer.Character then

			for _,Object in ipairs(
				OtherPlayer.Character:GetChildren()
			) do

				if Object:IsA("Accessory")
				or Object:IsA("Shirt")
				or Object:IsA("Pants")
				or Object:IsA("ShirtGraphic") then

					HiddenClothes[Object] =
						Object.Parent

					Object.Parent = nil

				end

			end

		end

	end

end

local function DisableClothes()

	for Object,Parent in pairs(
		HiddenClothes
	) do

		if Object and Parent then

			pcall(function()

				Object.Parent = Parent

			end)

		end

	end

	HiddenClothes = {}

end

--========================================================--
-- MEMORIA
--========================================================--

local function EnableMemory()

	task.spawn(function()

		while State.Memory do

			task.wait(15)

			pcall(function()

				collectgarbage("collect")

			end)

		end

	end)

end

local function DisableMemory()
	State.Memory = false
end

--========================================================--
-- EFECTOS DEL PERSONAJE
--========================================================--

local function OptimizeCharacter(Character)

	if not Character then
		return
	end

	for _,Object in ipairs(
		Character:GetDescendants()
	) do

		if Object:IsA("ParticleEmitter")
		or Object:IsA("Trail")
		or Object:IsA("Beam") then

			if CharacterEffects[Object] == nil then

				CharacterEffects[Object] =
					Object.Enabled

			end

			Object.Enabled = false

		end

	end

end

local function EnableCharacter()

	if Player.Character then

		OptimizeCharacter(
			Player.Character
		)

	end

end

local function DisableCharacter()

	for Object,Value in pairs(
		CharacterEffects
	) do

		if Object and Object.Parent then

			Object.Enabled = Value

		end

	end

	CharacterEffects = {}

end

