--========================================================--
-- CREAR BOTONES
--========================================================--

for _,name in ipairs(options) do

	createToggle(
		name,
		callbacks[name]
	)

end

--========================================================--
-- EVENTO DE LOS SWITCHES
--========================================================--

for _,name in ipairs(options) do

	local data =
		toggleButtons[name]

	if data then

		data.button.Activated:Connect(
			function()

				setToggle(
					name,
					not states[name]
				)

			end
		)

	end

end

--========================================================--
-- ABRIR BURBUJA
--========================================================--

bubble.Activated:Connect(function()

	if bubbleMoved then

		bubbleMoved = false

		return

	end

	bubble.Visible = false

	menu.Visible = true

	menu.Size =
		UDim2.new(0,0,0,0)

	local tween =
		TweenService:Create(

			menu,

			TweenInfo.new(
				0.25,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),

			{
				Size =
					UDim2.new(
						0,260,0,420
					)
			}

		)

	tween:Play()

end)

--========================================================--
-- CERRAR
--========================================================--

close.Activated:Connect(function()

	local tween =
		TweenService:Create(

			menu,

			TweenInfo.new(
				0.20,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			),

			{
				Size =
					UDim2.new(
						0,0,0,0
					)
			}

		)

	tween:Play()

	tween.Completed:Connect(function()

		menu.Visible = false

		bubble.Visible = true

	end)

end)

--========================================================--
-- RESPAWN
--========================================================--

player.CharacterAdded:Connect(
	function(character)

		task.wait(1)

		if states[
			"Character Optimizer"
		] then

			optimizeCharacter(
				character
			)

		end

		if states["Player Only"] then

			task.wait(0.5)

			enablePlayerOnly()

		end

	end
)

