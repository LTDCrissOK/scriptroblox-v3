local function createStatsGUI()

	if fpsGui then
		return
	end

	fpsGui =
		Instance.new("ScreenGui")

	fpsGui.Name =
		"LTDC_STATS"

	fpsGui.ResetOnSpawn = false

	fpsGui.IgnoreGuiInset = true

	fpsGui.DisplayOrder =
		999998

	fpsGui.ZIndexBehavior =
		Enum.ZIndexBehavior.Sibling

	fpsGui.Parent =
		GUI_PARENT

	--====================================================--
	-- FPS
	--====================================================--

	fpsBox =
		Instance.new("TextButton")

	fpsBox.Size =
		UDim2.new(0,105,0,28)

	fpsBox.Position =
		UDim2.new(1,-115,0,10)

	fpsBox.BackgroundColor3 =
		Color3.fromRGB(0,0,0)

	fpsBox.BackgroundTransparency =
		0.28

	fpsBox.Text =
		"FPS  ..."

	fpsBox.TextColor3 =
		Color3.fromRGB(255,255,255)

	fpsBox.Font =
		Enum.Font.GothamBold

	fpsBox.TextSize = 12

	fpsBox.AutoButtonColor = false

	fpsBox.Active = true

	fpsBox.Visible = false

	fpsBox.ZIndex = 100

	fpsBox.Parent = fpsGui


	local fpsCorner =
		Instance.new("UICorner")

	fpsCorner.CornerRadius =
		UDim.new(0,7)

	fpsCorner.Parent = fpsBox

	--====================================================--
	-- PING
	--====================================================--

	pingBox =
		Instance.new("TextButton")

	pingBox.Size =
		UDim2.new(0,105,0,28)

	pingBox.Position =
		UDim2.new(1,-115,0,43)

	pingBox.BackgroundColor3 =
		Color3.fromRGB(0,0,0)

	pingBox.BackgroundTransparency =
		0.28

	pingBox.Text =
		"PING  ..."

	pingBox.TextColor3 =
		Color3.fromRGB(255,255,255)

	pingBox.Font =
		Enum.Font.GothamBold

	pingBox.TextSize = 12

	pingBox.AutoButtonColor = false

	pingBox.Active = true

	pingBox.Visible = false

	pingBox.ZIndex = 100

	pingBox.Parent = fpsGui

	local pingCorner =
		Instance.new("UICorner")

	pingCorner.CornerRadius =
		UDim.new(0,7)

	pingCorner.Parent = pingBox

	--====================================================--
	-- FPS DESDE EL HUD
	--====================================================--

	fpsBox.Activated:Connect(function()

		if states["FPS"] then

			states["FPS"] = false

			if fpsConnection then

				fpsConnection:Disconnect()
				fpsConnection = nil

			end

			fpsBox.Visible = false

		else

			enableFPS()

		end

	end)

	--====================================================--
	-- PING DESDE EL HUD
	--====================================================--

	pingBox.Activated:Connect(function()

		if states["Ping Monitor"] then

			states["Ping Monitor"] = false

			pingBox.Visible = false

		else

			enablePing()

		end

	end)

end

--========================================================--
-- FPS
--========================================================--

function enableFPS()

	createStatsGUI()

	states["FPS"] = true

	fpsBox.Visible = true

	fpsBox.Text =
		"FPS  ..."

	frameCount = 0

	lastFPSTime = tick()

	if fpsConnection then
		return
	end

	fpsConnection =
		RunService.RenderStepped:Connect(
			function()

				if not states["FPS"] then
					return
				end

				frameCount += 1

				local now =
					tick()

				if now - lastFPSTime >= 0.5 then

					currentFPS =
						math.floor(
							frameCount /
							(now - lastFPSTime)
						)

					fpsBox.Text =
						"FPS  "..currentFPS

					frameCount = 0

					lastFPSTime = now

				end

			end
		)

end

--========================================================--
-- DESACTIVAR FPS
--========================================================--

function disableFPS()

	states["FPS"] = false

	if fpsConnection then

		fpsConnection:Disconnect()

		fpsConnection = nil

	end

	if fpsBox then

		fpsBox.Visible = false
		fpsBox.Text = "FPS"

	end

end

--========================================================--
-- PING
--========================================================--

function enablePing()

	createStatsGUI()

	states["Ping Monitor"] = true

	pingBox.Visible = true

	pingBox.Text =
		"PING  ..."

	if pingThread then
		return
	end

	pingThread =
		task.spawn(function()

			while states["Ping Monitor"] do

				local ping = 0

				pcall(function()

					local network =
						Stats.Network

					local server =
						network.ServerStatsItem

					local dataPing =
						server:FindFirstChild(
							"Data Ping"
						)

					if dataPing then

						ping =
							math.floor(
								dataPing:GetValue()
							)

					end

				end)

				pingBox.Text =
					"PING  "..ping.." ms"

				task.wait(1)

			end

			pingThread = nil

		end)

end

--========================================================--
-- DESACTIVAR PING
--========================================================--

function disablePing()

	states["Ping Monitor"] = false

	if pingBox then

		pingBox.Visible = false
		pingBox.Text = "PING"

	end

end

--========================================================--
-- PANTALLA
--========================================================--

local function enableScreen()

	for _,obj in ipairs(
		player.PlayerGui:GetChildren()
	) do

		if obj:IsA("ScreenGui")
		and obj.Name ~= "LTDC_STATS" then

			local scale =
				obj:FindFirstChild(
					"LTDC_UIScale"
				)

			if not scale then

				scale =
					Instance.new("UIScale")

				scale.Name =
					"LTDC_UIScale"

				scale.Parent = obj

			end

			scale.Scale = 1.2

			uiScales[obj] = scale

		end

	end

end


local function disableScreen()

	for _,scale in pairs(uiScales) do

		if scale and scale.Parent then

			scale.Scale = 1

		end

	end

	uiScales = {}

end

--========================================================--
-- PRENDAS
--========================================================--

local function enableClothes()

	for _,plr in ipairs(
		Players:GetPlayers()
	) do

		if plr ~= player
		and plr.Character then

			for _,obj in ipairs(
				plr.Character:GetChildren()
			) do

				if obj:IsA("Accessory")
				or obj:IsA("Hat")
				or obj:IsA("Shirt")
				or obj:IsA("Pants")
				or obj:IsA("ShirtGraphic") then

					if hiddenClothes[obj] == nil then

						hiddenClothes[obj] =
							obj.Parent

					end

					obj.Parent = nil

				end

			end

		end

	end

end


local function disableClothes()

	for obj,parent in pairs(
		hiddenClothes
	) do

		if obj and parent then

			pcall(function()

				obj.Parent = parent

			end)

		end

	end

	hiddenClothes = {}

end

--========================================================--
-- MEMORIA
--========================================================--

local memoryThread


local function enableMemory()

	if memoryThread then
		return
	end

	memoryThread =
		task.spawn(function()

			while states["Memoria"] do

				task.wait(15)

				pcall(function()
					collectgarbage("collect")
				end)

			end

			memoryThread = nil

		end)

end


local function disableMemory()

	states["Memoria"] = false

end

--========================================================--
-- AI OPTIMIZER
--========================================================--

local aiConnection


local function enableAI()

	if aiConnection then
		return
	end

	aiConnection =
		RunService.Heartbeat:Connect(
			function()

				if not states["AI Optimizer"] then
					return
				end

			end
		)

end


local function disableAI()

	if aiConnection then

		aiConnection:Disconnect()

		aiConnection = nil

	end

end

--========================================================--
-- STATIC WORLD
--========================================================--

local function enableStaticWorld()

	for _,obj in ipairs(
		Workspace:GetDescendants()
	) do

		if obj:IsA("BasePart") then

			safeSet(
				obj,
				"AssemblyLinearVelocity",
				Vector3.zero
			)

			safeSet(
				obj,
				"AssemblyAngularVelocity",
				Vector3.zero
			)

		end

	end

end


local function disableStaticWorld()
end

--========================================================--
-- PLAYER ONLY
--========================================================--

local function enablePlayerOnly()

	hiddenWorld = {}

	for _,obj in ipairs(
		Workspace:GetDescendants()
	) do

		if obj:IsA("BasePart") then

			local model =
				obj:FindFirstAncestorOfClass(
					"Model"
				)

			if model
			and model ~= player.Character
			and not model:FindFirstChildOfClass(
				"Humanoid"
			) then

				hiddenWorld[obj] =
					obj.Transparency

				obj.Transparency = 1

			end

		end

	end

end


local function disablePlayerOnly()

	for obj,value in pairs(
		hiddenWorld
	) do

		if obj and obj.Parent then

			obj.Transparency = value

		end

	end

	hiddenWorld = {}

end

--========================================================--
-- MEMORY GUARD
--========================================================--

local memoryGuardConnection


local function enableMemoryGuard()

	if memoryGuardConnection then
		return
	end

	memoryGuardConnection =
		RunService.Heartbeat:Connect(
			function()

				if not states["Memory Guard"] then
					return
				end

				local memory =
					collectgarbage("count")

				if memory > 300000 then

					pcall(function()

						collectgarbage("collect")

					end)

				end

			end
		)

end


local function disableMemoryGuard()

	if memoryGuardConnection then

		memoryGuardConnection:Disconnect()

		memoryGuardConnection = nil

	end

end

