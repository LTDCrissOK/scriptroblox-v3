--========================================================--
-- CHARACTER OPTIMIZER
--========================================================--

local function optimizeCharacter(character)

	if not character then
		return
	end

	for _,obj in ipairs(
		character:GetDescendants()
	) do

		if obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam") then

			if characterEffects[obj] == nil then

				characterEffects[obj] =
					obj.Enabled

			end

			obj.Enabled = false

		end

	end

end


local function enableCharacterOptimizer()

	if player.Character then

		optimizeCharacter(
			player.Character
		)

	end

	disconnect(
		"CharacterOptimizer"
	)

	connections["CharacterOptimizer"] =
		player.CharacterAdded:Connect(
			function(character)

				task.wait(1)

				if states[
					"Character Optimizer"
				] then

					optimizeCharacter(
						character
					)

				end

			end
		)

end


local function disableCharacterOptimizer()

	disconnect(
		"CharacterOptimizer"
	)

	for obj,value in pairs(
		characterEffects
	) do

		if obj and obj.Parent then

			obj.Enabled = value

		end

	end

	characterEffects = {}

end

--========================================================--
-- NPC OPTIMIZER
--========================================================--

local function isNPC(model)

	if not model:IsA("Model") then
		return false
	end

	local humanoid =
		model:FindFirstChildOfClass(
			"Humanoid"
		)

	if not humanoid then
		return false
	end

	return Players:GetPlayerFromCharacter(
		model
	) == nil

end


local function optimizeNPC(model)

	if not isNPC(model) then
		return
	end

	for _,obj in ipairs(
		model:GetDescendants()
	) do

		if obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam") then

			if npcEffects[obj] == nil then

				npcEffects[obj] =
					obj.Enabled

			end

			obj.Enabled = false

		end

	end

end


local function enableNPCOptimizer()

	for _,obj in ipairs(
		Workspace:GetDescendants()
	) do

		if obj:IsA("Model")
		and isNPC(obj) then

			optimizeNPC(obj)

		end

	end

end


local function disableNPCOptimizer()

	for obj,value in pairs(
		npcEffects
	) do

		if obj and obj.Parent then

			obj.Enabled = value

		end

	end

	npcEffects = {}

end

--========================================================--
-- AUDIO
--========================================================--

local function enableAudioOptimizer()

	for _,obj in ipairs(
		Workspace:GetDescendants()
	) do

		if obj:IsA("Sound") then

			if audioObjects[obj] == nil then

				audioObjects[obj] =
					obj.Volume

			end

			if obj.Volume > 0.5 then

				obj.Volume = 0.5

			end

		end

	end

end


local function disableAudioOptimizer()

	for obj,value in pairs(
		audioObjects
	) do

		if obj and obj.Parent then

			obj.Volume = value

		end

	end

	audioObjects = {}

end

--========================================================--
-- VEGETACIÓN
--========================================================--

local function enableVegetationOptimizer()

	for _,obj in ipairs(
		Workspace:GetDescendants()
	) do

		if obj:IsA("ParticleEmitter") then

			if vegetationObjects[obj] == nil then

				vegetationObjects[obj] =
					obj.Enabled

			end

			obj.Enabled = false

		end

	end

end


local function disableVegetationOptimizer()

	for obj,value in pairs(
		vegetationObjects
	) do

		if obj and obj.Parent then

			obj.Enabled = value

		end

	end

	vegetationObjects = {}

end

--========================================================--
-- STREAMING
--========================================================--

local function enableStreamingHelper()

	local character,humanoid,root =
		getCharacter()

	if root then

		pcall(function()

			player:
				RequestStreamAroundAsync(
					root.Position
				)

		end)

	end

end


local function disableStreamingHelper()
end

--========================================================--
-- CREAR SWITCH
--========================================================--

local function createToggle(name,callback)

	local button =
		Instance.new("TextButton")

	button.Name =
		name.."_Toggle"

	button.Size =
		UDim2.new(1,-8,0,40)

	button.BackgroundColor3 =
		Color3.fromRGB(25,25,25)

	button.Text = ""

	button.AutoButtonColor = false

	button.Active = true

	button.ZIndex = 53

	button.Parent = Scroll


	local corner =
		Instance.new("UICorner")

	corner.CornerRadius =
		UDim.new(0,9)

	corner.Parent = button

	--====================================================--
	-- TEXTO
	--====================================================--

	local label =
		Instance.new("TextLabel")

	label.Size =
		UDim2.new(1,-70,1,0)

	label.Position =
		UDim2.new(0,12,0,0)

	label.BackgroundTransparency = 1

	label.Text = name

	label.TextColor3 =
		Color3.fromRGB(255,255,255)

	label.Font =
		Enum.Font.GothamBold

	label.TextSize = 12

	label.TextXAlignment =
		Enum.TextXAlignment.Left

	label.ZIndex = 54

	label.Parent = button

	--====================================================--
	-- SWITCH
	--====================================================--

	local switch =
		Instance.new("Frame")

	switch.Size =
		UDim2.new(0,48,0,24)

	switch.Position =
		UDim2.new(1,-58,0.5,-12)

	switch.BackgroundColor3 =
		Color3.fromRGB(190,45,45)

	switch.ZIndex = 55

	switch.Parent = button


	local switchCorner =
		Instance.new("UICorner")

	switchCorner.CornerRadius =
		UDim.new(1,0)

	switchCorner.Parent = switch

	--====================================================--
	-- CÍRCULO
	--====================================================--

	local knob =
		Instance.new("Frame")

	knob.Size =
		UDim2.new(0,18,0,18)

	knob.Position =
		UDim2.new(0,5,0.5,-9)

	knob.BackgroundColor3 =
		Color3.fromRGB(255,255,255)

	knob.ZIndex = 56

	knob.Parent = switch


	local knobCorner =
		Instance.new("UICorner")

	knobCorner.CornerRadius =
		UDim.new(1,0)

	knobCorner.Parent = knob

	--====================================================--
	-- GUARDAR
	--====================================================--

	states[name] = false

	toggleButtons[name] = {
		button = button,
		switch = switch,
		knob = knob
	}

	toggleCallbacks[name] = callback

end

--========================================================--
-- CAMBIAR SWITCH
--========================================================--

local function setToggle(name,enabled)

	states[name] = enabled

	local data =
		toggleButtons[name]

	if data then

		if enabled then

			data.switch.BackgroundColor3 =
				Color3.fromRGB(
					30,180,80
				)

			data.knob.Position =
				UDim2.new(
					1,-23,0.5,-9
				)

		else

			data.switch.BackgroundColor3 =
				Color3.fromRGB(
					190,45,45
				)

			data.knob.Position =
				UDim2.new(
					0,5,0.5,-9
				)

		end

	end

	if toggleCallbacks[name] then

		pcall(function()

			toggleCallbacks[name](enabled)

		end)

	end

end

